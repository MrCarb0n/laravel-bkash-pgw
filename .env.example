# bKash PGW — copy these into your Laravel app's .env
# Sandbox credentials: https://developer.bka.sh (Tokenized Checkout → Sandbox)

# true = sandbox, false = production
BKASH_SANDBOX=true

# Tokenized API hosts (override only if bKash gives you different ones)
BKASH_SANDBOX_BASE_URL=https://tokenized.sandbox.bka.sh
BKASH_PRODUCTION_BASE_URL=https://tokenized.pay.bka.sh

# Checkout API host (B2C payout family)
BKASH_CHECKOUT_SANDBOX_BASE_URL=https://checkout.sandbox.bka.sh
BKASH_CHECKOUT_PRODUCTION_BASE_URL=https://checkout.pay.bka.sh

# Default merchant account
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Where bKash redirects the payer after payment (must be public HTTPS in production)
BKASH_CALLBACK_URL=https://yourdomain.com/bkash/callback

# Production: flip the flag and swap credentials
# BKASH_SANDBOX=false
# BKASH_APP_KEY=your_live_app_key
# BKASH_APP_SECRET=your_live_app_secret
# BKASH_USERNAME=your_live_username
# BKASH_PASSWORD=your_live_password

# Extra accounts (e.g. secondary) go in config/bkash.php under 'accounts',
# each with its own app_key / app_secret / username / password.
